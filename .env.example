# Copy to .env and fill in. Never commit .env.

# The only required setting. The provider is detected from the key, and the app
# finds the free models that work with it automatically.
GLOBAL_API_KEY=your_api_key_here

# Optional overrides:
# LLM_PROVIDER=groq          # groq | gemini | openrouter | mistralai | openai | anthropic
# LLM_MODELS=model-a,model-b # skip discovery; first is primary, rest are fallbacks
# LLM_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server (e.g. Ollama)
