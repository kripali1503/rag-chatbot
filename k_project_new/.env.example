# Copy to .env and fill in. Never commit .env.

# One key for whichever provider you choose.
GLOBAL_API_KEY=your_api_key_here

# groq | openai | anthropic | mistralai
LLM_PROVIDER=groq

# Comma-separated model IDs for that provider. The first is primary, the rest are fallbacks.
LLM_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Optional: any OpenAI-compatible endpoint (use with LLM_PROVIDER=openai).
# OpenRouter: https://openrouter.ai/api/v1
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
# Ollama:     http://localhost:11434/v1
# LLM_BASE_URL=
